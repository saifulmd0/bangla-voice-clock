    "recordedDeviations": [
      {
        "what": "Dark-mode header band is earth-deep #7A2E1C, not earth #9C3D26",
        "why": "Full fired earth glares next to the #1C1310 dark ground at night; rice #F6F0E4 keeps about 8.3:1 on earth-deep."
      },
      {
        "what": "Dial box is 280pt, not the contract's 240pt",
        "why": "Day-part labels sit outside a ring of about 240pt and need the room at the 480pt window width."
      }
    ]
