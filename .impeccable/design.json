  "components": [
    {
      "name": "Speak Now Button",
      "kind": "button",
      "refersTo": "button-speak",
      "description": "The one filled button, centred under the dial band.",
      "html": "<button class=\"ds-btn-speak\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"><circle cx=\"9\" cy=\"8\" r=\"3.5\"/><path d=\"M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6\"/><path d=\"M16 5.5c1 .9 1 2.6 0 3.5M18.5 3.5c2.1 2 2.1 5.5 0 7.5\"/></svg>এখনই সময় শুনুন</button>",
      "css": ".ds-btn-speak{font-family:'Hind Siliguri',sans-serif;display:inline-flex;align-items:center;gap:8px;background:#2F6B3F;color:#FFFFFF;border:none;border-radius:9999px;padding:14px 22px;font-size:16px;font-weight:600;cursor:pointer;transition:background .15s}.ds-btn-speak:hover{background:#306C40;filter:brightness(1.08)}.ds-btn-speak:active{filter:brightness(.92)}.ds-btn-speak:focus-visible{outline:2px solid #2F6B3F;outline-offset:3px}"
    },
    {
      "name": "Dial Header Band",
      "kind": "custom",
      "refersTo": "dial-header",
      "description": "Fired-earth band holding today's alpona dial; earth-deep in dark mode.",
      "html": "<div class=\"ds-dial-band\"><svg viewBox=\"0 0 280 280\" width=\"280\" height=\"280\"><g fill=\"none\" stroke=\"rgba(246,240,228,.75)\" stroke-width=\"3\" stroke-linecap=\"round\"><path d=\"M140 47.6 A92.4 92.4 0 0 1 222 97\"/><path d=\"M226 104 A92.4 92.4 0 0 1 226 176\"/><path d=\"M222 183 A92.4 92.4 0 0 1 58 183\"/><path d=\"M54 176 A92.4 92.4 0 0 1 54 104\"/><path d=\"M58 97 A92.4 92.4 0 0 1 133 47.8\"/></g><g fill=\"#F6F0E4\"><circle cx=\"140\" cy=\"33.6\" r=\"3\"/><circle cx=\"193\" cy=\"47.8\" r=\"2.2\"/><circle cx=\"232\" cy=\"87\" r=\"3\"/><circle cx=\"246\" cy=\"140\" r=\"2.2\"/><circle cx=\"232\" cy=\"193\" r=\"3\"/></g><circle cx=\"87\" cy=\"47.8\" r=\"9.1\" fill=\"#9C3D26\"/><circle cx=\"87\" cy=\"47.8\" r=\"7\" fill=\"#E2A12B\"/><text x=\"140\" y=\"146\" text-anchor=\"middle\" class=\"ds-dial-time\">সকাল ১০:২০</text></svg></div>",
      "css": ".ds-dial-band{background:#9C3D26;padding:20px 0;display:flex;justify-content:center}.ds-dial-time{font-family:'Hind Siliguri',sans-serif;fill:#F6F0E4;font-size:30px;font-weight:600}@media (prefers-color-scheme:dark){.ds-dial-band{background:#7A2E1C}}"
    },
    {
      "name": "Grouped Section Card",
      "kind": "card",
      "refersTo": "group-card",
      "description": "Earth section title over an outlined, shadowless card of 16pt rows.",
      "html": "<section class=\"ds-section\"><h3 class=\"ds-section-title\">ঘোষণা</h3><div class=\"ds-card\"><div class=\"ds-row\">সময় ঘোষণা চালু</div><div class=\"ds-row\">কতক্ষণ পরপর</div></div></section>",
      "css": ".ds-section{font-family:'Hind Siliguri',sans-serif;}.ds-section-title{margin:0 0 4px 8px;font-size:16px;font-weight:700;color:#9C3D26}.ds-card{background:#FFFDF8;border:1px solid #E2D5C3;border-radius:14px;overflow:hidden}.ds-row{padding:12px 16px;font-size:16px;font-weight:500;color:#231A16}.ds-row:hover{background:#F6EFE3}"
    },
    {
      "name": "Segmented Control",
      "kind": "custom",
      "refersTo": "segmented-track",
      "description": "macOS sliding segmented control at full row width.",
      "html": "<div class=\"ds-seg\" role=\"radiogroup\"><button class=\"ds-seg-opt ds-seg-on\" role=\"radio\" aria-checked=\"true\">১৫ মিনিট</button><button class=\"ds-seg-opt\" role=\"radio\" aria-checked=\"false\">৩০ মিনিট</button><button class=\"ds-seg-opt\" role=\"radio\" aria-checked=\"false\">১ ঘণ্টা</button></div>",
      "css": ".ds-seg{display:flex;background:#EBE1D1;padding:3px;border-radius:9px;width:100%}.ds-seg-opt{font-family:'Hind Siliguri',sans-serif;flex:1;border:none;background:transparent;padding:6px 0;font-size:15px;font-weight:600;color:#231A16;border-radius:7px;cursor:pointer;transition:background .2s}.ds-seg-on{background:#FFFDF8;box-shadow:0 3px 8px rgba(0,0,0,.12),0 1px 1px rgba(0,0,0,.04)}.ds-seg-opt:focus-visible{outline:2px solid #2F6B3F;outline-offset:1px}"
    },
    {
      "name": "Switch Row",
      "kind": "input",
      "refersTo": "group-card",
      "description": "Cupertino switch, leaf when on, warm outline when off.",
      "html": "<label class=\"ds-switch-row\">সময় ঘোষণা চালু<input type=\"checkbox\" class=\"ds-switch\" checked></label>",
      "css": ".ds-switch-row{font-family:'Hind Siliguri',sans-serif;display:flex;justify-content:space-between;align-items:center;padding:12px 16px;font-size:16px;font-weight:500;color:#231A16}.ds-switch{appearance:none;width:51px;height:31px;border-radius:9999px;background:#9C8878;position:relative;cursor:pointer;transition:background .2s}.ds-switch::after{content:'';position:absolute;top:2px;left:2px;width:27px;height:27px;border-radius:50%;background:#fff;box-shadow:0 3px 8px rgba(0,0,0,.15);transition:transform .2s}.ds-switch:checked{background:#2F6B3F}.ds-switch:checked::after{transform:translateX(20px)}.ds-switch:focus-visible{outline:2px solid #2F6B3F;outline-offset:2px}"
    },
    {
      "name": "Radio Row",
      "kind": "input",
      "refersTo": "group-card",
      "description": "Cupertino radio with title and example subtitle; unchosen ring stays visible.",
      "html": "<label class=\"ds-radio-row\"><input type=\"radio\" name=\"ds-style\" class=\"ds-radio\" checked><span><span class=\"ds-radio-title\">প্রচলিত</span><span class=\"ds-radio-sub\">সকাল সোয়া দশটা</span></span></label><label class=\"ds-radio-row\"><input type=\"radio\" name=\"ds-style\" class=\"ds-radio\"><span><span class=\"ds-radio-title\">মিনিট ধরে</span><span class=\"ds-radio-sub\">সকাল দশটা বেজে পনেরো মিনিট</span></span></label>",
      "css": ".ds-radio-row{font-family:'Hind Siliguri',sans-serif;display:flex;gap:24px;align-items:center;padding:10px 16px;cursor:pointer}.ds-radio{appearance:none;width:18px;height:18px;border-radius:50%;background:#D5CBC0;margin:0;flex:none}.ds-radio:checked{background:#fff;border:5px solid #2F6B3F}.ds-radio:focus-visible{outline:2px solid #2F6B3F;outline-offset:2px}.ds-radio-title{display:block;font-size:16px;font-weight:500;color:#231A16}.ds-radio-sub{display:block;font-size:16px;line-height:1.35;color:#5E4B40}"
    },
    {
      "name": "Hour Pop-up Button",
      "kind": "input",
      "refersTo": "popup-button",
      "description": "macOS-style pop-up for quiet hours, not an underlined dropdown.",
      "html": "<button class=\"ds-popup\">রাত ১১:০০<svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M8 9l4-4 4 4M8 15l4 4 4-4\"/></svg></button>",
      "css": ".ds-popup{font-family:'Hind Siliguri',sans-serif;display:inline-flex;align-items:center;gap:4px;padding:8px 8px 8px 14px;border:1px solid #9C8878;border-radius:8px;background:transparent;color:#231A16;font-size:15px;font-weight:600;cursor:pointer}.ds-popup:hover{background:rgba(35,26,22,.06)}.ds-popup:focus-visible{outline:2px solid #2F6B3F;outline-offset:2px}"
    },
    {
      "name": "Footer Text Link",
      "kind": "nav",
      "refersTo": "text-link",
      "description": "Leaf text links to the developer and the credits page.",
      "html": "<nav class=\"ds-footer\"><a href=\"#\" class=\"ds-link\">ডেভেলপ করেছেন সাইফুল ইসলাম</a><span>·</span><a href=\"#\" class=\"ds-link\">কৃতজ্ঞতা</a></nav>",
      "css": ".ds-footer{font-family:'Hind Siliguri',sans-serif;display:flex;justify-content:center;align-items:center;gap:4px;color:#231A16}.ds-link{color:#2F6B3F;font-size:15px;font-weight:600;text-decoration:none;padding:8px 12px;border-radius:9999px}.ds-link:hover{background:rgba(47,107,63,.08)}.ds-link:focus-visible{outline:2px solid #2F6B3F}"
    }
